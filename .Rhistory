rhine_points <- ais_classified |>
filter(on_river, str_detect(river_name, regex("Rhine|Rhein", ignore_case = TRUE))) |>
st_transform(3035)
rhine_points <- rhine_points |>
mutate(
distance_km = distance_along_line_km(rhine_points, rhine_line),
distance_bin_km = floor(distance_km / 10) * 10
)
rhine_density <- rhine_points |>
st_drop_geometry() |>
count(distance_bin_km, name = "n_records") |>
